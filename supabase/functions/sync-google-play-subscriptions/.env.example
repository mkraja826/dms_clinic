# Server-side lifecycle reconciliation. Never commit the real secret.
GOOGLE_PLAY_SYNC_ENABLED=false
GOOGLE_PLAY_SYNC_SECRET=replace-with-a-long-random-secret

# Hosted Supabase already holds these for the purchase verifier:
# GOOGLE_PLAY_PACKAGE_NAME=com.dms.clinic
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=<base64-service-account-json>
