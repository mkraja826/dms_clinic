# Server-side kill switch. Keep false until the migration, function, webhook,
# FCM credentials, and Internal Testing build have all been approved.
PAYMENT_PUSH_ENABLED=false

# Generate a long random value in a secure password manager. Never commit the
# real value or paste it into client-side EXPO_PUBLIC_* variables.
PAYMENT_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-long-random-secret

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the hosted Edge
# Function runtime. Never expose the service-role key in the mobile app.
