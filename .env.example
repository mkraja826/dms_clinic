EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: legacy projects can use EXPO_PUBLIC_SUPABASE_ANON_KEY instead.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deep link opened by Supabase password recovery emails.
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=dms://auth/reset-password

# Release feature flags. Keep disabled until separately tested and approved.
EXPO_PUBLIC_ENABLE_PAID_PLANS=false
EXPO_PUBLIC_ENABLE_PRICING_V2_OBSERVATION=false
EXPO_PUBLIC_ENABLE_REALTIME=true
EXPO_PUBLIC_ENABLE_FIREBASE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_PHONEPE_PAYMENTS=false

# PhonePe merchant credentials are SERVER-ONLY Supabase Edge Function secrets.
# Never create EXPO_PUBLIC_PHONEPE_CLIENT_ID, EXPO_PUBLIC_PHONEPE_CLIENT_SECRET,
# or any public callback credential in the Android bundle.

# CapDent v21 staged modules. Both global kill switches stay disabled until
# their additive migrations and backend prerequisites are approved separately.
EXPO_PUBLIC_ENABLE_PAYMENT_PUSH=false
EXPO_PUBLIC_ENABLE_TOOTH_CHART=false

# Clinical uploads use Supabase Storage.
EXPO_PUBLIC_USE_SIGNED_STORAGE_URLS=true
