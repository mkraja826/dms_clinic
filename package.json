{
  "name": "dms-mobile-app",
  "version": "1.2.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android": "npm run build:android:play-internal",
    "build:android:apk": "npm run check:v25:rc && npm run verify:android-signing && eas build --platform android --profile preview",
    "build:android:aab": "npm run build:android:play-internal",
    "build:android:play-internal": "npm run check:v25:rc && npm run verify:android-signing && eas build --platform android --profile play-internal",
    "build:android:production": "npm run check:v25:rc && npm run verify:android-signing && eas build --platform android --profile production",
    "submit:android:play-internal": "eas submit --platform android --profile play-internal",
    "submit:android:production": "eas submit --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "sync:v18-version": "node scripts/sync-capdent-v18-version.mjs",
    "prepare:v18": "node scripts/prepare-capdent-v18-build.mjs",
    "validate:v18": "node scripts/validate-capdent-v18.mjs",
    "sync:v21-version": "node scripts/sync-capdent-v21-version.mjs",
    "prepare:v21": "node scripts/prepare-capdent-v21-build.mjs",
    "validate:v21": "node scripts/validate-capdent-v21.mjs",
    "validate:v25": "node scripts/validate-capdent-v25.mjs",
    "validate:v25:rc": "node scripts/validate-capdent-v25.mjs --rc",
    "verify:android-signing": "node scripts/verify-android-signing.mjs",
    "check:v18": "npm run prepare:v18 && npm run validate:v18 && npm run typecheck",
    "check:v21": "npm run prepare:v21 && npm run validate:v21 && npm run typecheck",
    "check:v25": "npm run validate:v25 && npm run typecheck",
    "check:v25:rc": "npm run validate:v25:rc && npm run typecheck"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "26.2.0",
    "@react-native-firebase/app": "26.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-iap": "^14.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  }
}
